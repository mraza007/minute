{
  "name": "local-transcription-app",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run --passWithNoTests",
    "test:accessibility": "vitest run src/accessibility.test.tsx",
    "test:soak": "vitest run src/reliability/recordingSoak.test.ts",
    "test:scale": "vitest run src/performance/libraryScale.test.tsx",
    "test:visual": "node scripts/visual-regression.mjs",
    "test:visual:update": "UPDATE_VISUAL_BASELINES=1 node scripts/visual-regression.mjs",
    "check:release": "node scripts/check-release.mjs",
    "build:macos:release": "bash scripts/build-macos-release.sh",
    "verify:macos-bundle": "bash scripts/verify-macos-bundle.sh",
    "test:watch": "vitest",
    "test:rust": "TAURI_CONFIG='{\"bundle\":{\"macOS\":{\"frameworks\":[]}}}' cargo test --manifest-path src-tauri/Cargo.toml",
    "verify": "npm run lint && npm run test && npm run build && npm run test:rust && npm run check:release"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "agent-browser": "^0.27.0",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
