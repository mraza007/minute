{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Minute",
  "version": "0.6.0",
  "identifier": "dev.minute.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "src-tauri/scripts/stage-frameworks.sh"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Minute",
        "width": 1280,
        "height": 800,
        "minWidth": 1180,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/notes/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "frameworks": [
        "frameworks/libggml-base.0.dylib",
        "frameworks/libggml-cpu.0.dylib",
        "frameworks/libggml-metal.0.dylib",
        "frameworks/libggml.0.dylib",
        "frameworks/libllama.0.dylib"
      ]
    }
  }
}
